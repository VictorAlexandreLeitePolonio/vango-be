begin;

-- Later cycles may emit notifications while these reusable fixtures execute.
-- Keep cleanup compatible with both the isolated cycle and the final schema.
do $optional_fixture_cleanup$
declare
  v_table text;
  v_fleets uuid[] := array[
    '41000000-0000-0000-0000-000000000001'::uuid,
    '41000000-0000-0000-0000-000000000002'::uuid
  ];
begin
  foreach v_table in array array[
    'private.notification_manual_commands',
    'private.trip_location_summaries',
    'public.notifications',
    'public.trip_route_calculations',
    'public.trip_location_points',
    'public.trip_location_receipts',
    'public.trip_current_locations'
  ] loop
    if to_regclass(v_table) is not null then
      execute format('delete from %s where fleet_id = any($1)',v_table) using v_fleets;
    end if;
  end loop;
  if to_regclass('private.notification_processed_events') is not null
    and to_regclass('public.trip_events') is not null then
    execute 'delete from private.notification_processed_events where event_id in
      (select id from public.trip_events where fleet_id=any($1))' using v_fleets;
  end if;
end;
$optional_fixture_cleanup$;


-- Delete only the dedicated Ciclo 4 fixture, in FK order.  This script is
-- invoked from operations.py only after it has verified vango_cycle_4.
delete from public.trip_incident_updates
where incident_id in (
  select id from public.trip_incidents
  where fleet_id in (
    '41000000-0000-0000-0000-000000000001',
    '41000000-0000-0000-0000-000000000002'
  )
);
